{
  "name": "SDV One - Prévia privada no iPad",
  "image": "mcr.microsoft.com/devcontainers/php:8.4-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "SDV One - abrir sistema",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-preview.sh",
  "postStartCommand": "bash .devcontainer/start-preview.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
